{
  "manifest_version": 3,
  "name": "Instagram Reels Speed Control",
  "version": "1.2",
  "description": "Контроль швидкості відео в Instagram Reels та завантаження рілсів. Shift+. прискорити, Shift+, сповільнити, ←/→ перемотка.",
  "permissions": [
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
